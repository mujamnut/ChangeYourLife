sdk.dir=C\:/Users/<your-user>/AppData/Local/Android/Sdk

# Android app backend URL.
# Emulator:
# cyl.api.base.url=http://10.0.2.2:8080/
# Physical phone:
# cyl.api.base.url=http://<your-computer-ip>:8080/

# Local LM Studio visual extraction/OCR only. It is never used for final text/actions.
# Backend must be able to reach this URL.
# If backend runs on the same PC as LM Studio, keep 127.0.0.1.
# If backend runs on Render, 127.0.0.1 will not reach your PC.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# LMSTUDIO_VISION_MODEL=qwen/qwen3.5-9b
# LMSTUDIO_API_KEY=
# Legacy compatibility only; accepted but ignored by Phase A runtime.
# LMSTUDIO_MODEL=qwen/qwen3.5-9b
#
# OpenRouter is the only provider for normal text chat and structured actions.
# Requests without visual input skip LM Studio entirely.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Legacy compatibility only; accepted but ignored by Phase A runtime.
# OPENROUTER_VISION_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-3-4b-it:free
# OPENROUTER_VISION_MODEL=
# AI_VISION_MODEL=
#
# There is no implicit cross-role fallback. With only LM Studio configured, AI
# status is degraded because OpenRouter is required for the final response.

# Optional AI deadline policy. Every remote attempt is capped by the shared remaining budget.
# LM Studio timeout applies to vision/OCR; OpenRouter timeout applies to text/actions.
# AI_JOB_DEADLINE_MS=180000
# AI_CONNECT_TIMEOUT_MS=5000
# LMSTUDIO_REQUEST_TIMEOUT_MS=90000
# OPENROUTER_REQUEST_TIMEOUT_MS=60000
# AI_FINALIZATION_RESERVE_MS=10000

# Optional AI web source.
# Android chat settings decide per-message whether web search is used.
# Jina search is attempted first and may work without a key; Exa/Tavily are fallback providers only when keys exist.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_TIMEOUT_MS=12000
# WEB_SEARCH_CACHE_TTL_SECONDS=900
# JINA_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=

# Backend PostgreSQL persistence.
# Aiven PostgreSQL service URI normally needs sslmode=require.
# Do not commit your real database password.
# DATABASE_URL=postgresql://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
# JWT_SECRET=replace-with-a-long-random-secret

# Backend forgot-password email provider.
# Resend requires a verified sender/domain in production.
# RESEND_API_KEY=re_your-key-here
# EMAIL_FROM=ChangeYourLife <noreply@yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com

# Private R2 storage used by voice notes and imported page assets.
# Configure these as backend environment variables on Render, never in the APK.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional override; normally derived from R2_ACCOUNT_ID.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_SIGNED_URL_TTL_SECONDS=300
# R2_DOWNLOAD_URL_TTL_SECONDS=300

# Generic image, PDF, and text asset lifecycle.
# Defaults to enabled when all R2 settings above are configured.
# CONTENT_ASSET_ENABLED=true
# CONTENT_ASSET_MAX_IMAGE_BYTES=15728640
# CONTENT_ASSET_MAX_PDF_BYTES=52428800
# CONTENT_ASSET_MAX_TEXT_BYTES=1048576
# CONTENT_ASSET_ORPHAN_TTL_HOURS=24
# CONTENT_ASSET_CLEANUP_INTERVAL_SECONDS=3600
